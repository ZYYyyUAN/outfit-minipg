.mask{position:fixed;inset:0;background:rgba(35,26,31,.4);z-index:100;display:flex;align-items:flex-end}.sheet{background:#FAF8F5;width:100%;height:92vh;display:flex;flex-direction:column;border-radius:28rpx 28rpx 0 0;color:#352E35;font-size:26rpx}.header,.footer{flex-shrink:0;display:flex;align-items:center;gap:16rpx;padding:16rpx 24rpx}.header text{font-size:34rpx;font-weight:600;flex:1}.body{flex:1;min-height:0;height:0}.search,.options{display:flex;flex-wrap:wrap;gap:8rpx;margin:12rpx 20rpx}.search input{flex:1;min-width:160rpx;background:white;padding:16rpx}.label{margin:24rpx 20rpx 12rpx;font-weight:600}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;padding:16rpx 20rpx}.item,.selected{background:white;padding:16rpx;border-radius:16rpx;min-width:0}.selected{margin:12rpx 20rpx}.item image{width:100%;height:220rpx}.selected image{width:100%;height:160rpx}.name{overflow-wrap:anywhere;margin:12rpx 0}.error{color:#A3344C;padding:16rpx}button{font-size:24rpx;min-height:88rpx;margin:0;padding:0 18rpx;display:flex;align-items:center;justify-content:center}button.active,.confirm{background:#A34F69;color:white}.footer{padding-bottom:calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #DDD0D5}.footer text{flex:1}