<view wx:if="{{open}}" class="mask" catchtap="cancel" catchtouchmove="stop"><view class="sheet" catchtap="stop">
<view class="header"><text>选择衣物</text><button bindtap="cancel">关闭</button></view>
<scroll-view class="body" scroll-y bindscrolltolower="more">
<view class="search"><input value="{{keywordDraft}}" maxlength="-1" placeholder="搜索衣物名称" bindinput="input" bindconfirm="search"/><button bindtap="search">搜索</button><button bindtap="reset">重置</button></view>
<view class="label">归档范围</view><view class="options"><button wx:for="{{scopes}}" wx:key="id" class="{{archived === item.id ? 'active' : ''}}" data-field="archived" data-value="{{item.id}}" bindtap="filter">{{item.name}}</button></view>
<view class="label">分类</view><view class="options"><button data-field="categoryId" data-value="" bindtap="filter">全部</button><button wx:for="{{categories}}" wx:key="id" class="{{categoryId === item.id ? 'active' : ''}}" data-field="categoryId" data-value="{{item.id}}" bindtap="filter">{{item.name}}</button></view>
<view class="label">颜色</view><view class="options"><button data-field="color" data-value="" bindtap="filter">全部</button><button wx:for="{{colors}}" wx:key="*this" class="{{color === item ? 'active' : ''}}" data-field="color" data-value="{{item}}" bindtap="filter">{{item}}</button></view>
<view class="label">季节</view><view class="options"><button data-field="season" data-value="" bindtap="filter">全部</button><button wx:for="{{seasons}}" wx:key="*this" class="{{season === item ? 'active' : ''}}" data-field="season" data-value="{{item}}" bindtap="filter">{{item}}</button></view>
<view wx:if="{{optionError}}" class="error">{{optionError}}<button bindtap="options">重试筛选选项</button></view>
<view class="label">已选 · {{chosen.length}}件（按顺序）</view>
<view wx:for="{{chosen}}" wx:key="id" class="selected"><image wx:if="{{item.src}}" src="{{item.src}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.src}}" binderror="imageFailed"/><button wx:else data-id="{{item.id}}" bindtap="retryImage">{{item.imageState === 'failed' ? '重试图片' : '读取中'}}</button><view class="name">{{index+1}}. {{item.name}}<text wx:if="{{item.isArchived}}"> · 已归档</text></view><view class="options"><button disabled="{{index === 0}}" data-index="{{index}}" data-step="-1" bindtap="move">上移</button><button disabled="{{index === chosen.length-1}}" data-index="{{index}}" data-step="1" bindtap="move">下移</button><button data-id="{{item.id}}" bindtap="remove">移除</button></view></view>
<view class="label">查询结果 · 共{{total}}件</view><view class="grid"><view wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="toggle"><image wx:if="{{item.src}}" src="{{item.src}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.src}}" binderror="imageFailed"/><button wx:else data-id="{{item.id}}" catchtap="retryImage">{{item.imageState === 'failed' ? '重试图片' : '读取中'}}</button><view class="name">{{item.name}}</view><text wx:if="{{item.isArchived}}">已归档 · </text><text>{{item.selected ? '已选，点击取消' : '点击选择'}}</text></view></view>
<view wx:if="{{!busy && !error && !items.length}}">没有匹配衣物，可重置条件。</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试查询</button></view><button wx:if="{{items.length < total}}" bindtap="more" disabled="{{busy}}">{{busy ? '读取中' : '加载更多'}}</button><view wx:if="{{busy}}">正在读取…</view>
</scroll-view><view class="footer"><text>已选 {{chosen.length}} / 20</text><button bindtap="cancel">取消</button><button class="confirm" bindtap="confirm">确定</button></view></view></view>