page { background: #FAF8F5; color: #2F2D32; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, button { box-sizing: border-box; }
.page { padding: 54rpx 28rpx 64rpx; }
.eyebrow { color: #A34F69; font-size: 24rpx; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.title { font-size: 44rpx; font-weight: 600; line-height: 1.35; margin: 0 0 24rpx; }
.description { color: #6D6670; line-height: 1.8; max-width: 620rpx; overflow-wrap: anywhere; }
.section { border-top: 1rpx solid #E8E2E3; margin-top: 60rpx; padding-top: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 500; margin-bottom: 12rpx; }
.label { display: inline-block; color: #A34F69; background: #F6E7ED; border-radius: 8rpx; padding: 8rpx 16rpx; font-size: 24rpx; margin-top: 26rpx; }
.button { margin: 32rpx 0 0; min-height: 88rpx; border-radius: 16rpx; padding: 20rpx 24rpx; background: #A34F69; color: #FFFFFF; font-size: 28rpx; line-height: 1.6; }
.button::after { border: none; }
.button[disabled] { background: #DCC7CF; color: #FFFFFF; }
.status { margin-top: 28rpx; padding-left: 22rpx; border-left: 4rpx solid #E8E2E3; overflow-wrap: anywhere; }
.status.success { border-left-color: #A34F69; }
.status.failed { border-left-color: #A32C42; }
.status-title { font-weight: 500; margin-bottom: 8rpx; }
.status.failed .status-title { color: #A32C42; }
.hint { font-size: 24rpx; color: #6D6670; line-height: 1.8; overflow-wrap: anywhere; }

.form { margin-top: 40rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.field-label { display: block; margin-top: 28rpx; margin-bottom: 12rpx; font-size: 28rpx; }
.required { color: #A34F69; }
.field { box-sizing: border-box; width: 100%; min-height: 96rpx; height: 96rpx; padding: 20rpx 22rpx; background: #FFFFFF; border: 1rpx solid #D8CBD0; border-radius: 12rpx; font-size: 28rpx; }
.count { float: right; color: #6D6670; font-size: 24rpx; }
.error { color: #A32C42; font-size: 26rpx; margin-top: 12rpx; overflow-wrap: anywhere; }
.button.secondary { background: transparent; color: #A34F69; border: 1rpx solid #CBAAB7; }
.button.secondary[disabled] { color: #83757A; border-color: #DCC7CF; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 54rpx; background: #F6E7ED; color: #A34F69; font-size: 36rpx; margin: 24rpx 0; }
.break-text { overflow-wrap: anywhere; word-break: break-all; }
