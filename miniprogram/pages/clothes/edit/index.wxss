.edit { padding-top:36rpx;padding-bottom:calc(56rpx + env(safe-area-inset-bottom)); }.image-box { width:100%;height:560rpx;background:#fff;border-radius:12rpx;display:flex;align-items:center;justify-content:center; }.image-box image { width:100%;height:100%; }.image-box .hint { padding:28rpx; }
.edit .button { margin-top:18rpx; }.image-actions { display:flex;gap:16rpx; }.image-actions .button { flex:1;min-width:0; }.picker-field { line-height:54rpx;overflow-wrap:anywhere;height:auto; }.note-field { min-height:260rpx;height:auto;line-height:1.8;padding:22rpx; }.form-actions { margin-top:36rpx;padding-top:20rpx;border-top:1rpx solid #E8E2E3; }.field-label { min-height:40rpx; }.count { float:right; }button::after { border:none; }
