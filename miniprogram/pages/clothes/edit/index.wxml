<view class="page edit">
  <view class="eyebrow">整理喜欢的日常单品</view><view class="title">{{editing ? '编辑衣物' : '新增衣物'}}</view>
  <view wx:if="{{error}}" class="status failed"><view class="error">{{error}}</view><button wx:if="{{!ready}}" class="button secondary" bindtap="load">重新读取</button></view>
  <block wx:if="{{ready}}">
    <view class="field-label">单品图片 <text class="required">*</text></view><view class="image-box" bindtap="preview"><image wx:if="{{src}}" src="{{src}}" mode="aspectFit" binderror="imageFailed"/><text wx:else class="hint">{{imageError || (form.imagePath ? '正在读取图片…' : '选择完整的单品图片')}}</text></view>
    <view class="hint">JPEG或PNG，每张不超过5MiB</view><button class="button secondary" bindtap="choose" disabled="{{busy || uploadState === 'uploading'}}">{{uploadState === 'uploading' ? '正在上传' : form.imagePath ? '更换图片' : '选择图片'}}</button><button wx:if="{{imageError && !candidate}}" class="button secondary" bindtap="readImage">重新读取图片</button>
    <view wx:if="{{uploadState === 'failed'}}" class="image-actions"><button class="button secondary" bindtap="upload">重试上传</button><button class="button secondary" bindtap="discardCandidate">放弃本次选图</button></view><view wx:if="{{errors.imagePath}}" class="error">{{errors.imagePath}}</view>
    <view class="field-label">名称 <text class="required">*</text><text class="count">{{nameCount}}/40</text></view><input class="field" value="{{form.name}}" maxlength="-1" data-field="name" bindinput="input" focus="{{focusField === 'name'}}" placeholder="例如：粉色针织开衫" disabled="{{busy}}"/><view wx:if="{{errors.name}}" class="error">{{errors.name}}</view>
    <view class="field-label">分类 <text class="required">*</text></view><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category" disabled="{{busy || !categories.length}}"><view class="field picker-field">{{categoryName}}</view></picker><view wx:if="{{categoryError}}" class="error">{{categoryError}}<button class="button secondary" bindtap="loadCategories">重试分类</button></view><view wx:if="{{errors.categoryId}}" class="error">{{errors.categoryId}}</view>
    <view class="field-label">颜色 <text class="required">*</text><text class="count">{{colorCount}}/20</text></view><input class="field" value="{{form.color}}" maxlength="-1" data-field="color" bindinput="input" focus="{{focusField === 'color'}}" placeholder="例如：浅粉色、藏蓝与灰色" disabled="{{busy}}"/><view wx:if="{{errors.color}}" class="error">{{errors.color}}</view>
    <view class="field-label">适用季节 <text class="required">*</text></view><picker range="{{seasons}}" value="{{seasonIndex}}" bindchange="season" disabled="{{busy}}"><view class="field picker-field">{{form.season || '请选择'}}</view></picker><view wx:if="{{errors.season}}" class="error">{{errors.season}}</view>
    <view class="field-label">备注 <text class="count">{{noteCount}}/500</text></view><textarea class="field note-field" value="{{form.note}}" maxlength="-1" data-field="note" bindinput="input" focus="{{focusField === 'note'}}" placeholder="记录版型、材质或搭配想法" disabled="{{busy}}" auto-height/><view wx:if="{{errors.note}}" class="error">{{errors.note}}</view>
    <view class="form-actions"><button class="button" bindtap="save" disabled="{{busy || uploadState === 'uploading' || candidate || !categories.length}}">{{busy ? '正在保存' : '保存衣物'}}</button><button class="button secondary" bindtap="cancel" disabled="{{busy || uploadState === 'uploading'}}">取消</button></view>
  </block>
</view>
