<view class="page detail">
  <view wx:if="{{loading}}" class="hint">正在读取衣物…</view>
  <view wx:if="{{error}}" class="status failed"><view class="error">{{error}}</view><button wx:if="{{!notFound && !clothing}}" class="button secondary" bindtap="load">重新加载</button><button wx:if="{{notFound}}" class="button secondary" bindtap="back">返回</button></view>
  <block wx:if="{{clothing}}">
    <view class="hero-image" bindtap="preview"><image wx:if="{{src}}" src="{{src}}" data-src="{{src}}" mode="aspectFit" binderror="imageFailed"/><text wx:else class="hint">{{imageError || '正在读取单品图片…'}}</text></view><button wx:if="{{imageError}}" class="text-button" bindtap="readImage">重试图片</button>
    <view class="title break-text">{{clothing.name}}</view><view wx:if="{{clothing.isArchived}}" class="archive-label">已归档</view>
    <view class="attributes"><text>{{clothing.categoryId === 'tops' ? '上装' : clothing.categoryId === 'outerwear' ? '外套' : clothing.categoryId === 'dresses' ? '连衣裙' : clothing.categoryId === 'bottoms' ? '下装' : clothing.categoryId === 'shoes' ? '鞋履' : clothing.categoryId === 'bags' ? '包袋' : '配饰'}}</text><text>{{clothing.color}}</text><text>{{clothing.season}}</text></view>
    <text class="note">{{clothing.note || '暂无备注'}}</text>
    <view class="wear"><view><text class="wear-number">{{clothing.wearCount}}</text><text class="hint"> 次穿着记录</text></view><view class="hint">最近穿着：{{clothing.lastWornDate || '尚未记录'}}</view></view>
    <view class="detail-actions"><button class="button" bindtap="edit" disabled="{{acting}}">编辑衣物</button><button class="button secondary" bindtap="archive" disabled="{{acting}}">{{acting ? '正在保存' : clothing.isArchived ? '恢复衣物' : '归档衣物'}}</button></view>
    <view class="section"><view class="section-title">相关搭配 <text class="hint">{{outfits.page ? '共 ' + outfits.total + ' 套' : ''}}</text></view><view class="hint">点击搭配查看完整组合</view>
      <view wx:for="{{outfits.items}}" wx:key="id" class="related" data-id="{{item.id}}" bindtap="outfit"><view class="related-title">{{item.name}}</view><view wx:if="{{item.isArchived}}" class="archive-label">已归档</view><view class="hint">{{item.occasion}} · 共{{item.clothingCount}}件</view><view class="previews"><view wx:for="{{item.previewItems}}" wx:for-item="child" wx:key="id" class="preview"><image wx:if="{{child.src}}" src="{{child.src}}" data-src="{{child.src}}" mode="aspectFit" data-kind="outfits" data-parent="{{item.id}}" data-id="{{child.id}}" binderror="previewFailed"/><button wx:else class="preview-retry" data-kind="outfits" data-parent="{{item.id}}" data-id="{{child.id}}" catchtap="retryPreview">{{child.imageError ? '重试图片' : '读取中'}}</button><view class="hint break-text">{{child.name}}</view></view></view></view>
      <view wx:if="{{outfits.busy}}" class="hint">正在读取搭配…</view><view wx:if="{{outfits.error}}" class="error">{{outfits.error}}</view><button wx:if="{{outfits.error || (outfits.page && outfits.items.length < outfits.total)}}" class="button secondary" bindtap="moreOutfits" disabled="{{outfits.busy}}">{{outfits.error ? '重试搭配' : '更多搭配'}}</button><view wx:if="{{outfits.page && !outfits.total}}" class="hint">暂无相关搭配</view>
    </view>
    <view class="section"><view class="section-title">穿着历史 <text class="hint">{{diaries.page ? '共 ' + diaries.total + ' 篇' : ''}}</text></view><view class="hint">相关记录详情暂未开放</view>
      <view wx:for="{{diaries.items}}" wx:key="id" class="related"><view class="related-title">{{item.wearDate}}</view><view class="hint">{{item.occasion}}<text wx:if="{{item.mood}}"> · {{item.mood}}</text> · 共{{item.clothingCount}}件<text wx:if="{{item.photoUrl}}"> · 有照片</text></view><view class="previews"><view wx:for="{{item.previewItems}}" wx:for-item="child" wx:key="id" class="preview"><image wx:if="{{child.src}}" src="{{child.src}}" data-src="{{child.src}}" mode="aspectFit" data-kind="diaries" data-parent="{{item.id}}" data-id="{{child.id}}" binderror="previewFailed"/><button wx:else class="preview-retry" data-kind="diaries" data-parent="{{item.id}}" data-id="{{child.id}}" catchtap="retryPreview">{{child.imageError ? '重试图片' : '读取中'}}</button><view class="hint break-text">{{child.name}}</view></view></view></view>
      <view wx:if="{{diaries.busy}}" class="hint">正在读取历史…</view><view wx:if="{{diaries.error}}" class="error">{{diaries.error}}</view><button wx:if="{{diaries.error || (diaries.page && diaries.items.length < diaries.total)}}" class="button secondary" bindtap="moreDiaries" disabled="{{diaries.busy}}">{{diaries.error ? '重试历史' : '更多历史'}}</button><view wx:if="{{diaries.page && !diaries.total}}" class="hint">暂无穿着记录</view>
    </view>
  </block>
</view>
