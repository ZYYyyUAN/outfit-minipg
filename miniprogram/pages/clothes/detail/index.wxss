.detail { padding-top:28rpx; }.hero-image { width:100%;height:700rpx;background:white;display:flex;align-items:center;justify-content:center;border-radius:12rpx; }.hero-image image { width:100%;height:100%; }.hero-image .hint { padding:28rpx; }
.detail .title { font-size:38rpx;margin-top:30rpx;margin-bottom:16rpx; }.archive-label { display:inline-block;color:#A34F69;background:#F6E7ED;padding:4rpx 14rpx;font-size:24rpx;margin-bottom:12rpx; }
.attributes { display:flex;flex-wrap:wrap;gap:16rpx;color:#6D6670;font-size:26rpx;margin:18rpx 0;overflow-wrap:anywhere; }.attributes text { max-width:100%; }
.note { display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:28rpx; }.wear { margin:32rpx 0;padding:24rpx 0;border-top:1rpx solid #E8E2E3;border-bottom:1rpx solid #E8E2E3; }.wear-number { font-size:44rpx;color:#A34F69; }
.detail-actions { display:flex;gap:18rpx; }.detail-actions .button { flex:1;margin:0;min-width:0; }.section { margin-top:44rpx; }.related { padding:28rpx 0;border-bottom:1rpx solid #E8E2E3; }.related-title { font-size:30rpx;font-weight:500;overflow-wrap:anywhere; }
.previews { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin-top:16rpx; }.preview { min-width:0; }.preview image { width:100%;height:260rpx;background:white; }.preview-retry { width:100%;min-height:88rpx;height:260rpx;background:#fff;color:#6D6670;font-size:24rpx;white-space:normal; }.text-button { background:transparent;color:#A34F69;min-height:88rpx;font-size:26rpx;padding:20rpx;margin:0; }button::after { border:none; }
