<view class="page edit"><view class="title">{{editing ? '编辑日记' : '新增日记'}}</view><view class="hint">通过下方取消按钮离开时，会确认尚未保存的修改。</view>
<view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!ready}}" bindtap="load">重新读取</button><button wx:if="{{clothingRefreshFailed}}" bindtap="refreshClothes" disabled="{{busy}}">重试更新衣物资料</button><block wx:if="{{ready}}">
<view id="field-wearDate"><view>穿着日期</view><picker mode="date" value="{{form.wearDate}}" bindchange="date" disabled="{{busy}}"><view class="date-picker">{{form.wearDate}} · 更改</view></picker><text class="error">{{errors.wearDate}}</text></view><view wx:if="{{conflict}}" class="error">{{conflict.wearDate}} 已有日记。草稿已保留，可更改日期。<button bindtap="existing" disabled="{{busy}}">查看已有日记</button></view><view class="hint">{{form.sourceOutfitId ? '保留来源搭配，实际清单可独立修改' : '直接记录，无来源搭配'}}</view><view id="field-occasion" class="field"><view>场景 · {{occasionCount}}/20</view><input value="{{form.occasion}}" maxlength="-1" data-field="occasion" bindinput="input" disabled="{{busy}}"/><text class="error">{{errors.occasion}}</text></view>
<view id="field-mood" class="field"><view>心情（可选，12字内）</view><input value="{{form.mood}}" maxlength="-1" data-field="mood" bindinput="input" disabled="{{busy}}"/><text class="error">{{errors.mood}}</text></view><view class="photo-section"><view>穿搭照片（可选）</view><image wx:if="{{photo}}" src="{{photo}}" mode="aspectFit" data-src="{{photo}}" binderror="photoFailed"/><view wx:if="{{photoError}}" class="error">{{photoError}}<button bindtap="readPhoto">重新读取</button></view><button bindtap="choosePhoto" disabled="{{busy}}">{{form.photoPath ? '替换照片' : '选择照片'}}</button><button wx:if="{{form.photoPath}}" bindtap="removePhoto" disabled="{{busy}}">移除照片</button></view><view id="field-note" class="field"><view>备注 · {{noteCount}}/1000</view><textarea value="{{form.note}}" maxlength="-1" data-field="note" bindinput="input" disabled="{{busy}}" auto-height/><text class="error">{{errors.note}}</text></view>
<view id="field-clothingIds" class="field"><view>实际穿着 · {{items.length}}件</view><text class="error">{{errors.clothingIds}}</text><button class="button secondary" bindtap="choose" disabled="{{busy || clothingRefreshFailed}}">选择衣物</button></view>
<view wx:for="{{items}}" wx:key="id" class="item"><image wx:if="{{item.src}}" src="{{item.src}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.src}}" binderror="imageFailed"/><button wx:else data-id="{{item.id}}" bindtap="retryImage">{{item.imageState === 'failed' ? '重试图片' : '图片读取中'}}</button><view class="name">{{index+1}}. {{item.name}}<text wx:if="{{item.isArchived}}"> · 已归档</text></view><view class="actions"><button disabled="{{busy || index === 0}}" data-index="{{index}}" data-step="-1" bindtap="move">上移</button><button disabled="{{busy || index === items.length-1}}" data-index="{{index}}" data-step="1" bindtap="move">下移</button><button disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">移除</button></view></view>
<view class="footer"><button bindtap="cancel" disabled="{{busy}}">取消</button><button class="button" bindtap="save" disabled="{{busy || clothingRefreshFailed}}">{{busy ? '正在保存…' : '保存日记'}}</button></view></block><button wx:if="{{!ready}}" bindtap="cancel">取消</button>
<clothes-picker id="picker" selected="{{items}}" epoch="{{epoch}}" bind:confirm="picked"/></view>