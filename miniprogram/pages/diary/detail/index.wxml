<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button><button bindtap="back">返回</button></view><view wx:if="{{diary}}"><view class="eyebrow">穿搭日记</view><view class="title">{{diary.wearDate}}</view><view>{{diary.occasion}}<text wx:if="{{diary.mood}}"> · {{diary.mood}}</text></view><text class="note">{{diary.note}}</text><view wx:if="{{diary.photoPath}}"><image wx:if="{{photo}}" class="photo" mode="aspectFit" src="{{photo}}" bindtap="preview" data-id="photo" data-src="{{photo}}" binderror="failed"/><button wx:else data-id="photo" bindtap="retry">重新读取照片</button></view><view class="section"><view wx:if="{{diary.sourceOutfitId}}" bindtap="source" class="source">来源：{{diary.sourceOutfitName}}{{diary.sourceOutfitArchived ? ' · 已归档' : ''}} →</view><view wx:else class="hint">直接记录，无来源搭配</view><view class="section-title">实际穿着 · {{diary.items.length}}件</view><view wx:for="{{diary.items}}" wx:key="id" class="item"><image wx:if="{{images['i'+item.id]}}" src="{{images['i'+item.id]}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{images['i'+item.id]}}" binderror="failed"/><button wx:else data-id="{{item.id}}" bindtap="retry">重试图片</button><view data-id="{{item.id}}" bindtap="clothing">{{index+1}}. {{item.name}}{{item.isArchived ? ' · 已归档' : ''}} →</view></view></view><button class="button" bindtap="edit" disabled="{{busy}}">编辑日记</button><button class="button secondary" bindtap="remove" disabled="{{busy}}">删除日记</button></view></view>