<view class="page"><view class="eyebrow">衣橱统计</view><view class="title">穿着留下的数字</view><view wx:if="{{busy}}" class="hint">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{value}}"><view class="hint">截至上海日期 {{value.asOf}}</view><view class="section"><view class="title">{{value.activeClothesCount}} 件</view><view class="hint">在用衣物</view><view wx:for="{{value.categoryDistribution}}" wx:key="id" class="distribution"><view>{{item.name}} · {{item.count}}</view><view class="track"><view style="width:{{value.activeClothesCount ? item.count / value.activeClothesCount * 100 : 0}}%"/></view></view></view><view class="section"><view class="section-title">月度记录天数</view><picker mode="date" fields="month" value="{{month}}" bindchange="month"><view class="month">{{month}} · 更改月份</view></picker><view class="title">{{value.monthDiaryDays}} 天</view></view><view class="section"><view class="section-title">累计常穿 Top 5</view><view wx:if="{{!value.mostWorn.length}}" class="hint">还没有已记录穿着的在用衣物</view><view wx:for="{{value.mostWorn}}" wx:key="id" data-id="{{item.id}}" bindtap="clothing" class="stat-row">{{index+1}}. {{item.name}}<view class="hint">{{item.wearCount}} 次 · 最近 {{item.lastWornDate}} →</view></view></view><view class="section"><view class="section-title">最近30天未穿 · {{value.notWornRecently.total}}件</view><view class="hint">{{from}} 至 {{value.asOf}}（含首尾）</view><view wx:for="{{value.notWornRecently.items}}" wx:key="id" data-id="{{item.id}}" bindtap="clothing" class="stat-row">{{item.name}}<view class="hint">最近穿着：{{item.lastWornDate || '从未记录'}} →</view></view><view wx:if="{{!value.notWornRecently.items.length}}" class="hint">本页暂无衣物</view><view class="pagination"><button bindtap="page" data-step="-1" disabled="{{busy || page === 1}}">上一页</button><text>{{page}}</text><button bindtap="page" data-step="1" disabled="{{busy || page * value.notWornRecently.pageSize &gt;= value.notWornRecently.total}}">下一页</button></view></view></block></view>