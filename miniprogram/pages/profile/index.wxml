<view class="page"><view class="eyebrow">我的账号</view><view class="title">编辑资料</view>
<view class="hint break-text">用户名：{{username}}（不可修改）</view><view class="form">
<label class="field-label" for="nickname">昵称 <text class="required">*</text><text class="count">{{count}}/20</text></label>
<input id="nickname" class="field" value="{{nickname}}" bindinput="input" maxlength="-1" disabled="{{busy}}" focus="{{focusField === 'nickname'}}" placeholder="1～20个字符" />
<view wx:if="{{fields.nickname}}" class="error">{{fields.nickname}}</view>
<view class="section"><view class="section-title">头像</view><view class="avatar-placeholder">衣</view>
<view class="hint">{{avatarPath ? '已保留当前头像引用，图片显示将在后续接入。' : '当前使用默认头像，上传将在后续接入。'}}</view>
<button wx:if="{{avatarPath}}" class="button secondary" bindtap="removeAvatar" disabled="{{busy}}">移除头像（保存后生效）</button></view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<button class="button" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存资料</button>
<button class="button secondary" bindtap="cancel" disabled="{{busy}}">取消</button>
</view></view>
