<view class="page"><view class="eyebrow">我的账号</view><view class="title">编辑资料</view>
<view wx:if="{{!ready}}" class="hint">正在读取资料…</view>
<view wx:else><view class="hint break-text">用户名：{{username}}（不可修改）</view><view class="form">
<label class="field-label" for="nickname">昵称 <text class="required">*</text><text class="count">{{count}}/20</text></label>
<input id="nickname" class="field" value="{{nickname}}" bindinput="input" maxlength="-1" disabled="{{busy}}" focus="{{focusField === 'nickname'}}" placeholder="1～20个字符" />
<view wx:if="{{fields.nickname}}" class="error">{{fields.nickname}}</view>
<view class="section"><view class="section-title">头像</view>
<image wx:if="{{avatarSrc}}" class="avatar-image" mode="aspectFit" src="{{avatarSrc}}" binderror="imageError" />
<view wx:else class="avatar-placeholder">衣</view>
<view class="hint">{{avatarState === 'loading' ? '正在读取图片…' : uploadState === 'uploading' ? '正在上传图片…' : avatarPath ? '图片已就绪，保存资料后应用。' : '可选择一张JPEG或PNG，最大5MiB。'}}</view>
<view wx:if="{{avatarError}}" class="error">{{avatarError}}</view>
<button wx:if="{{avatarState === 'failed' && !selectedLocalPath}}" class="button secondary" bindtap="refreshAvatar" disabled="{{busy || uploadState === 'uploading'}}">重新读取图片</button>
<button class="button secondary" bindtap="chooseAvatar" disabled="{{busy || uploadState === 'uploading'}}">{{avatarPath || selectedLocalPath ? '更换图片' : '选择图片'}}</button>
<view wx:if="{{uploadState === 'failed'}}"><button class="button secondary" bindtap="uploadSelected" disabled="{{busy}}">重试上传</button><button class="button secondary" bindtap="discardSelection" disabled="{{busy}}">放弃本次选图</button></view>
<button wx:if="{{avatarPath || selectedLocalPath}}" class="button secondary" bindtap="removeAvatar" disabled="{{busy || uploadState === 'uploading'}}">移除头像（保存后生效）</button></view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<button class="button" bindtap="save" loading="{{busy}}" disabled="{{busy || uploadState === 'uploading' || selectedLocalPath}}">保存资料</button>
<button class="button secondary" bindtap="cancel" disabled="{{busy}}">取消</button>
</view></view></view>
