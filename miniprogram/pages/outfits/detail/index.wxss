.detail { padding-top:32rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom)); }.detail .title { font-size:38rpx;margin-bottom:16rpx; }.archive-label { display:inline-block;color:#A34F69;background:#F6E7ED;padding:4rpx 14rpx;font-size:24rpx;margin-bottom:12rpx; }.occasion { color:#6D6670;font-size:28rpx;margin:16rpx 0 24rpx; }.note { display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:28rpx; }
.detail-actions { display:flex;gap:18rpx;margin-top:28rpx; }.detail-actions .button { flex:1;margin:0;min-width:0; }.detail .hint { margin-top:12rpx; }.section { margin-top:36rpx; }.items { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28rpx 22rpx; }.clothing { min-width:0; }.picture { width:100%;height:400rpx;background:#fff;display:flex;align-items:center;justify-content:center;border-radius:10rpx; }.picture image { width:100%;height:100%; }.picture .hint { padding:20rpx; }.clothing-name { overflow-wrap:anywhere;font-size:28rpx;font-weight:500;margin:16rpx 0 12rpx; }.text-button { background:transparent;color:#A34F69;min-height:88rpx;font-size:26rpx;padding:20rpx;margin:0; }button::after { border:none; }
