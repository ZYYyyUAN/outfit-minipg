.outfits { padding-top:36rpx; }.heading { display:flex;align-items:center;justify-content:space-between;gap:20rpx; }.heading .title { margin-bottom:20rpx; }.add { flex-shrink:0;margin:0;padding:18rpx;min-height:88rpx;font-size:24rpx;border-radius:12rpx; }
.search { display:flex;align-items:center;background:#fff;border:1rpx solid #D8CBD0;border-radius:12rpx;padding:0 12rpx;margin-top:24rpx; }.search input { flex:1;min-width:0;height:96rpx;font-size:28rpx; }.search button { margin:0;background:transparent;color:#A34F69;font-size:26rpx;padding:20rpx 12rpx;min-height:88rpx; }button::after { border:none; }
.filter-row,.result-row { display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:88rpx; }.filter-row .hint { min-width:0; }.text-button { flex-shrink:0;margin:0;background:transparent;color:#A34F69;min-height:88rpx;padding:20rpx 12rpx;font-size:26rpx;line-height:1.8; }
.filter-panel { padding:24rpx 0;border-top:1rpx solid #E8E2E3;border-bottom:1rpx solid #E8E2E3; }.options,.actions { display:flex;flex-wrap:wrap;gap:12rpx; }.chip { margin:0;background:transparent;color:#6D6670;border:1rpx solid #D8CBD0;border-radius:12rpx;min-height:88rpx;padding:18rpx 22rpx;font-size:26rpx;line-height:1.8;white-space:normal;overflow-wrap:anywhere;max-width:100%; }.chip.selected { background:#F6E7ED;color:#A34F69;border-color:#A34F69; }.actions { justify-content:flex-end;align-items:center; }.actions .button { margin:0;padding:18rpx 32rpx; }
.outfit-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx 22rpx; }.outfit { min-width:0; }.previews { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6rpx;background:#fff;padding:6rpx;border-radius:12rpx; }.preview { min-width:0;height:160rpx; }.preview image { width:100%;height:100%; }.preview-retry { width:100%;height:100%;margin:0;padding:4rpx;background:#FAF8F5;color:#6D6670;font-size:22rpx;display:flex;align-items:center;justify-content:center;white-space:normal; }.preview-retry[disabled] { color:#6D6670;background:#FAF8F5; }
.outfit-name { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere;font-size:28rpx;font-weight:500;line-height:1.5;margin-top:16rpx; }.archive-label { display:inline-block;background:#F6E7ED;color:#A34F69;font-size:24rpx;padding:4rpx 12rpx;margin-top:8rpx; }.empty { padding:48rpx 0;text-align:center; }
