<view class="page edit"><view class="title">{{editing ? '编辑搭配' : '新增搭配'}}</view><view class="hint">通过下方取消按钮离开时，会确认尚未保存的修改。</view>
<view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!ready}}" bindtap="load">重新读取</button><button wx:if="{{clothingRefreshFailed}}" bindtap="refreshClothes" disabled="{{busy}}">重试更新衣物资料</button><block wx:if="{{ready}}">
<view id="field-name" class="field"><view>名称 · {{nameCount}}/40</view><input value="{{form.name}}" maxlength="-1" data-field="name" bindinput="input" disabled="{{busy}}"/><text class="error">{{errors.name}}</text></view>
<view id="field-occasion" class="field"><view>场景 · {{occasionCount}}/20</view><input value="{{form.occasion}}" maxlength="-1" data-field="occasion" bindinput="input" disabled="{{busy}}"/><text class="error">{{errors.occasion}}</text></view>
<view id="field-note" class="field"><view>备注 · {{noteCount}}/500</view><textarea value="{{form.note}}" maxlength="-1" data-field="note" bindinput="input" disabled="{{busy}}" auto-height/><text class="error">{{errors.note}}</text></view>
<view id="field-clothingIds" class="field"><view>组合单品 · {{items.length}}件</view><text class="error">{{errors.clothingIds}}</text><button class="button secondary" bindtap="choose" disabled="{{busy || clothingRefreshFailed}}">选择衣物</button></view>
<view wx:for="{{items}}" wx:key="id" class="item"><image wx:if="{{item.src}}" src="{{item.src}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.src}}" binderror="imageFailed"/><button wx:else data-id="{{item.id}}" bindtap="retryImage">{{item.imageState === 'failed' ? '重试图片' : '图片读取中'}}</button><view class="name">{{index+1}}. {{item.name}}<text wx:if="{{item.isArchived}}"> · 已归档</text></view><view class="actions"><button disabled="{{busy || index === 0}}" data-index="{{index}}" data-step="-1" bindtap="move">上移</button><button disabled="{{busy || index === items.length-1}}" data-index="{{index}}" data-step="1" bindtap="move">下移</button><button disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">移除</button></view></view>
<view class="footer"><button bindtap="cancel" disabled="{{busy}}">取消</button><button class="button" bindtap="save" disabled="{{busy || clothingRefreshFailed}}">{{busy ? '正在保存…' : '保存搭配'}}</button></view></block><button wx:if="{{!ready}}" bindtap="cancel">取消</button>
<clothes-picker id="picker" selected="{{items}}" epoch="{{epoch}}" bind:confirm="picked"/></view>