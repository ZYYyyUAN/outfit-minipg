.edit{padding-bottom:200rpx}.edit .field{margin:32rpx 0;height:auto;min-height:0;padding:0;background:transparent;border:0}.field input,.field textarea{background:#FFF;padding:24rpx;box-sizing:border-box;width:100%;margin-top:12rpx}.item{background:white;border-radius:20rpx;padding:24rpx;margin:20rpx 0}.item image{width:100%;height:300rpx}.name{overflow-wrap:anywhere;margin:16rpx 0}.actions{display:flex;gap:12rpx;flex-wrap:wrap}.edit button{font-size:26rpx;min-height:88rpx}.footer{position:fixed;bottom:0;left:0;right:0;background:#FAF8F5;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:24rpx;z-index:2}.footer button{flex:1;margin:0}.hint{font-size:24rpx}